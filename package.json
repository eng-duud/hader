{
  "name": "hader-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "seed": "tsx scripts/seed.ts",
    "create-owner": "tsx scripts/create-owner.ts",
    "test:rls": "tsx scripts/test-rls.ts",
    "test:admin": "tsx scripts/test-admin-auth.ts",
    "test:step4": "tsx scripts/test-step4-content.ts",
    "test:step5": "tsx scripts/test-step5-clients.ts",
    "test:step6": "tsx scripts/test-step6-public.ts",
    "test:step7": "tsx scripts/test-step7-leads.ts",
    "test:step8": "tsx scripts/test-step8-audit.ts",
    "test:e2e:smoke": "tsx scripts/test-e2e-smoke.ts",
    "test:e2e": "playwright test",
    "test:all": "tsx scripts/test-step8-audit.ts && tsx scripts/test-e2e-smoke.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.48.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.460.0",
    "next": "14.2.24",
    "next-intl": "^3.26.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.4.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.24",
    "postcss": "^8.4.47",
    "prettier": "^3.3.3",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "packageManager": "pnpm@9.15.4"
}
