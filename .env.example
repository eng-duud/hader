# ==============================================================================
# Hader (حاضر) — Environment Variables Configuration
# Copy this file to .env.local for local development. Never commit real secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Site Configuration
# ------------------------------------------------------------------------------
# The canonical base URL used for sitemaps, hreflang, and metadata generation.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Database, Auth, Storage)
# ------------------------------------------------------------------------------
# Public Supabase project URL (safe for client bundle)
NEXT_PUBLIC_SUPABASE_URL=

# Public Supabase anon key (subject to Row Level Security, safe for client bundle)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key (SERVER-ONLY: full privileges, bypasses RLS, NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. Email Delivery (Resend or SMTP Provider)
# ------------------------------------------------------------------------------
# Resend API key for lead dispatch and system alerts
RESEND_API_KEY=

# Official email address of the owner to receive new lead notifications
OWNER_NOTIFICATION_EMAIL=

# ------------------------------------------------------------------------------
# 4. Anti-Spam Protection (Cloudflare Turnstile - Optional)
# ------------------------------------------------------------------------------
# Cloudflare Turnstile public site key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudflare Turnstile secret key (SERVER-ONLY)
TURNSTILE_SECRET_KEY=

# ------------------------------------------------------------------------------
# 5. Analytics (Optional)
# ------------------------------------------------------------------------------
# Privacy-friendly analytics domain or ID (Vercel Analytics / Plausible)
NEXT_PUBLIC_ANALYTICS_DOMAIN=
